---
# Java Observability Toolkit (JOT)
# https://openo11y.org

sensors:

- name: http-route
  description: Identifies the route for this HTTP request
  methods:
  - javax.servlet.Servlet.service
  - jakarta.servlet.Servlet.service
  captures:
    path: "#P0.getRequestURI()"

  
- name: auth-user
  description: Identifies user names
  methods:
  - javax.servlet.Servlet.service
  - jakarta.servlet.Servlet.service
  captures:
    user: '#P0.getRemoteUser()==null ? "Guest" : #P0.getRemoteUser()'
  
  
- name: auth-role-check
  description: "Records each role check and whether the current user has the role, like ADMIN: true"
  methods:
  - javax.servlet.ServletRequest.isUserInRole
  - jakarta.servlet.ServletRequest.isUserInRole
  captures:
    role: "#P0"
    allowed: "#RET"
    user: '#OBJ.getRemoteUser() == null ? "Guest" : #OBJ.getRemoteUser()'
  matchers:
    role:
      - "!null"
    allowed:
      - "!null"
    
  
- name: http-parameter-received
  description: Identifies parameter names used in HTTP requests
  methods:
  - javax.servlet.Servlet.service
  - jakarta.servlet.Servlet.service
  captures:
    name: "#P0.getParameterNames()"
  matchers:
    name:
      - "!null"


- name: http-parameter-read
  description: Identifies parameter names referenced by the app
  methods:
  - javax.servlet.ServletRequest.getParameter
  - jakarta.servlet.ServletRequest.getParameter
  - javax.servlet.ServletRequest.getParameterValues
  - jakarta.servlet.ServletRequest.getParameterValues
  captures:
    name: "#P0"
  matchers:
    name:
      - "!null"


- name: http-redirect
  description: Extracts any response redirects in this app
  methods:
  - javax.servlet.ServletResponse.sendRedirect
  - jakarta.servlet.ServletResponse.sendRedirect
  captures:
    url: "#P0"
  matchers:
    url:
      - "!null"


- name: http-forward
  description: Extracts any request forwards in this app
  methods:
  - javax.servlet.ServletRequest.getRequestDispatcher
  - jakarta.servlet.ServletRequest.getRequestDispatcher
  - javax.servlet.ServletContext.getRequestDispatcher
  - jakarta.servlet.ServletContext.getRequestDispatcher
  captures:
    path: "#P0"
  matchers:
    path:
      - "!null"


- name: http-filter-registered
  description: Extracts the filters in this app"
  methods:
  - javax.servlet.ServletContext.addFilter
  - jakarta.servlet.ServletContext.addFilter
  captures:
    urls: "#RET.getUrlPatternMappings()"
  matchers:
    urls:
      - "!null"


- name: http-servlet-registered
  description: Identifies the servlets in this app
  methods:
  - javax.servlet.ServletContext.addServlet
  - jakarta.servlet.ServletContext.addServlet
  captures:
    urls: "#RET.getMappings()"
  matchers:
    urls:
      - "!null"


- name: http-cache-header
  description: Identifies whether cache header is set
  methods:
  - javax.servlet.ServletResponse.setHeader
  - jakarta.servlet.ServletResponse.setHeader
  captures:
    cache_control: '#P0.equalsIgnoreCase("Cache-Control")?#P1:null'
  matchers:
    cache_control:
      - "!null"


- name: get-privacy
  description: Identifies PII creation
  methods:
  - javax.servlet.ServletRequest.getParameter
  - jakarta.servlet.ServletRequest.getParameter
  - javax.servlet.ServletRequest.getParameterValues
  - jakarta.servlet.ServletRequest.getParameterValues
  scopes:
  - javax.servlet.Servlet.service
  - jakarta.servlet.Servlet.service
  captures:
    value: "#P0"
  matchers:
    value:
      - (?!000|666)[0-8][0-9]{2}-(?!00)[0-9]{2}-(?!0000)[0-9]{4}
      - (?<visa>4[0-9]{12}(?:[0-9]{3})?)
      - (?<mastercard>5[1-5][0-9]{14})
      - (?<discover>6(?:011|5[0-9]{2})[0-9]{12})
      - (?<amex>3[47][0-9]{13})
      - (?<diners>3(?:0[0-5]|[68][0-9])?[0-9]{11})
      - (?<jcb>(?:2131|1800|35[0-9]{3})[0-9]{11})
  

##### detect attacks #####

- name: expression-suspicious
  description: An expression contained dangerous patterns
  methods:
  - javax.servlet.jsp.el.ExpressionEvaluator.evaluate
  - jakarta.servlet.jsp.el.ExpressionEvaluator.evaluate
  - org.springframework.expression.parseExpression
  captures:
    expression: "#P0"
  matchers:
    expression:
      - \.class
  block-when: true
  

- name: expression
  description: An expression being evaluated used a harmful method
  methods:
  - java.lang.ProcessBuilder.<init>
  - java.io.Socket.<init>
  scopes:
  - javax.servlet.jsp.el.ExpressionEvaluator.evaluate
  - jakarta.servlet.jsp.el.ExpressionEvaluator.evaluate
  - org.springframework.expression.parseExpression
  captures:
    expression: "#P0"
  block-when: true

