---
# Java Observability Toolkit (JOT)

sensors:

- name: crypto-cipher
  description: Identifies a cipher being used, its algorithm and whether it encrypts or decrypts
  methods:
  - javax.crypto.Cipher.init
  captures:
    algorithm: "#OBJ.getAlgorithm()"
    operation: '#P0 == 1 ? "encrypt" : #P0 == 2 ? "decrypt" : "other"'


- name: native-library
  description: Identifies loading a native library
  methods:
  - java.lang.System.load
  - java.lang.System.loadLibrary
  - java.lang.System.mapLibraryName
  captures:
    name: "#P0"
  matchers:
    name:
      - "!null"
  

- name: sql-statement
  description: Identifies unparameterized database queries
  methods:
  - java.sql.Statement.execute
  - java.sql.Statement.addBatch
  - java.sql.Statement.executeQuery
  - java.sql.Statement.executeUpdate
  excludes:
  - java.sql.PreparedStatement   #these calls are harmless in PreparedStatement
  captures:
    sql: "#ARGS"


- name: file-path
  description: Identifies file and directory use
  methods:
  - java.io.File.<init>
  captures:
    path: "#OBJ.getCanonicalPath()"
  matchers:
    path:
      - '!\/apache\-tomcat'
      - "!sdkman"
      - '!eclipse\-workspace'


- name: net-socket
  description: Identifies a socket being opened
  methods:
  - java.net.Socket.<init>
  captures:
    host: "#P0"
    port: "#P1"
  debug: "true"
  matchers:
    host:
      - "!null"
    port:
      - "!^8080$"


- name: route
  description: Identifies the route a request came in at
  methods:
  - javax.servlet.Servlet.service
  - jakarta.servlet.Servlet.service
  captures:
    path: "#P0.getRequestURI()"

  
- name: check-role
  description: Identifies a role being checked
  methods:
  - javax.servlet.ServletRequest.isUserInRole
  - jakarta.servlet.ServletRequest.isUserInRole
  captures:
    role: "#P0"
    
  
- name: get-parameter
  description: Identifies a parameter being read and its value
  methods:
  - javax.servlet.ServletRequest.getParameter
  - jakarta.servlet.ServletRequest.getParameter
  - javax.servlet.ServletRequest.getParameterValues
  - jakarta.servlet.ServletRequest.getParameterValues
  - javax.servlet.ServletRequest.getQueryString
  - jakarta.servlet.ServletRequest.getQueryString
  captures:
    name: "#P0"
    value: "#RET"
  matchers:
    name:
      - "!null"
    value:
      - "!null"
 
- name: get-header
  description: Identifies a request header being read and its value
  methods:
  - javax.servlet.ServletRequest.getHeader
  - jakarta.servlet.ServletRequest.getHeader
  - javax.servlet.ServletRequest.getHeaders
  - jakarta.servlet.ServletRequest.getHeaders
  captures:
    name: "#P0"
    value: "#RET"
  matchers:
    name:
      - "!null"
    value:
      - "!null"
 
- name: get-cookies
  description: Identifies cookies being read
  methods:
  - javax.servlet.ServletRequest.getCookies
  - jakarta.servlet.ServletRequest.getCookies
  captures:
    name: "#P0"
    value: "#RET"
  matchers:
    name:
      - "!null"
    value:
      - "!null"
 
- name: multipart
  description: Identifies a multipart upload being read
  methods:
  - javax.servlet.ServletRequest.getPart
  - jakarta.servlet.ServletRequest.getPart
  - javax.servlet.ServletRequest.getParts
  - jakarta.servlet.ServletRequest.getParts
  captures:
    name: "#P0"
  matchers:
    name:
      - "!null"


- name: send-redirect
  description: Identifies a redirect being sent
  methods:
  - javax.servlet.ServletResponse.sendRedirect
  - jakarta.servlet.ServletResponse.sendRedirect
  captures:
    url: "#P0"
  matchers:
    url:
      - "!null"


- name: request-forward
  description: Identifies a request being forwarded
  methods:
  - javax.servlet.ServletRequest.getRequestDispatcher
  - jakarta.servlet.ServletRequest.getRequestDispatcher
  - javax.servlet.ServletContext.getRequestDispatcher
  - jakarta.servlet.ServletContext.getRequestDispatcher
  captures:
    path: "#P0"
  matchers:
    path:
      - "!null"


- name: set-header
  description: Identifies a response header being set and its value
  methods:
  - javax.servlet.ServletResponse.setHeader
  - jakarta.servlet.ServletResponse.setHeader
  captures:
    name: "#P0"
    value: "#P1"
  matchers:
    name:
      - "!null"
    value:
      - "!null"


- name: credit-card
  description: Identifies a credit card number in a request parameter
  methods:
  - javax.servlet.ServletRequest.getParameter
  - jakarta.servlet.ServletRequest.getParameter
  - javax.servlet.ServletRequest.getParameterValues
  - jakarta.servlet.ServletRequest.getParameterValues
  scopes:
  - javax.servlet.Servlet.service
  - jakarta.servlet.Servlet.service
  captures:
    value: "#P0"
  matchers:
    value:
      - (?!000|666)[0-8][0-9]{2}-(?!00)[0-9]{2}-(?!0000)[0-9]{4}
      - (?<visa>4[0-9]{12}(?:[0-9]{3})?)
      - (?<mastercard>5[1-5][0-9]{14})
      - (?<discover>6(?:011|5[0-9]{2})[0-9]{12})
      - (?<amex>3[47][0-9]{13})
      - (?<diners>3(?:0[0-5]|[68][0-9])?[0-9]{11})
      - (?<jcb>(?:2131|1800|35[0-9]{3})[0-9]{11})

- name: native-process
  description: Identifies starting a native process
  methods:
  - java.lang.ProcessBuilder.<init>
  scopes:
  - javax.servlet.Servlet.service
  - jakarta.servlet.Servlet.service
  captures:
    command: "#ARGS"


- name: expression-language
  description: Identifies an expression being evaluated
  methods:
  - javax.el.ValueExpression.getValue
  - jakarta.el.ValueExpression.getValue
  scopes:
  - javax.servlet.Servlet.service
  - jakarta.servlet.Servlet.service
  captures:
    expression: "#OBJ.getExpressionString()"

