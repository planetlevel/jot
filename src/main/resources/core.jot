---
# Java Observability Toolkit (JOT)

sensors:

- name: crypto-cipher
  description: Identifies a cipher being used, its algorithm and whether it encrypts or decrypts
  methods:
  - javax.crypto.Cipher.init
  captures:
    algorithm: "#OBJ.getAlgorithm()"
    operation: '#P0 == 1 ? "encrypt" : #P0 == 2 ? "decrypt" : "other"'


- name: native-library
  description: Identifies loading a native library
  methods:
  - java.lang.System.load
  - java.lang.System.loadLibrary
  - java.lang.System.mapLibraryName
  captures:
    name: "#P0"
  matchers:
    name:
      - "!null"
  

- name: sql-statement
  description: Identifies unparameterized database queries
  methods:
  - java.sql.Statement.execute
  - java.sql.Statement.addBatch
  - java.sql.Statement.executeQuery
  - java.sql.Statement.executeUpdate
  excludes:
  - java.sql.PreparedStatement   #these calls are harmless in PreparedStatement
  captures:
    sql: "#ARGS"


- name: sql-prepared
  description: Identifies parameterized database queries
  methods:
  - java.sql.Connection.prepareCall
  - java.sql.Connection.prepareStatement
  captures:
    sql: "#ARGS"


- name: file-path
  description: Identifies file and directory use
  methods:
  - java.io.File.<init>
  captures:
    path: "#OBJ.getCanonicalPath()"
  matchers:
    path:
      - '!\/apache\-tomcat'
      - "!sdkman"
      - '!eclipse\-workspace'


- name: net-socket
  description: Identifies a socket being opened
  methods:
  - java.net.Socket.<init>
  captures:
    host: "#P0"
    port: "#P1"
  debug: "true"
  matchers:
    host:
      - "!null"
    port:
      - "!^8080$"


- name: get-exceptions
  description: Identifies an exception being created
  methods:
  - Exception.<init>
  scopes:
  - javax.servlet.Servlet.service
  - jakarta.servlet.Servlet.service
  captures:
    exception: "#P0"

