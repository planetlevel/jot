sensors:
# no scopes, so it applies only while the application is running, which here is inside a method carrying @Entry
- name: file-in-app
  methods:
  - java.io.File.<init>
  captures:
    path: "#P0"
  matchers:
    path:
      - ^(inside|outside)/
- name: digest-in-app
  methods:
  - java.security.MessageDigest.getInstance
  captures:
    algorithm: "#P0"
  matchers:
    algorithm:
      - ^(SHA-256|MD5)$
# scopes: [] means anywhere, also before and after the application runs
- name: file-anywhere
  scopes: []
  methods:
  - java.io.File.<init>
  captures:
    path: "#P0"
  matchers:
    path:
      - ^(inside|outside)/
# on the entry point itself. The call that starts the application is the application, so this applies, which is how the route
# sensor of a web application can see where each request came in
- name: on-entry
  methods:
  - "@Demo$Entry"
  captures:
    value: "#P0"
