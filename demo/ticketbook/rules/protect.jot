---
# TicketBook demo, the rules. A sensor with an exception is a rule, its message says why the call is bad.
# run.sh always loads this file. MODE decides what the rules do.
#   monitor   the rules only report, nothing is stopped, the attacks still work
#   protect   the rules stop the call
# The dashboard's Protection panel can switch single rules between the two while the app runs.
# Each rule lists both the javax and the jakarta names, so these work on Tomcat 9 and Tomcat 11.

sensors:

# A web request must never start an operating system process.
- name: native-process
  description: Blocks attempts to start native processes from a web request
  methods:
  - java.lang.ProcessBuilder.<init>
  scopes:
  - javax.servlet.Servlet.service
  - jakarta.servlet.Servlet.service
  captures:
  - "#ARGS"
  exception: Attempt to create a process from within Servlet.service() prevented by JOT rule 'native-process'

# A web request must never deserialize objects.
- name: object-deserialization
  description: Blocks attempts to deserialize objects from a web request
  methods:
  - java.io.ObjectInputStream.readObject
  - java.io.ObjectInputStream.readUnshared
  scopes:
  - javax.servlet.Servlet.service
  - jakarta.servlet.Servlet.service
  captures:
  - "#ARGS"
  exception: Attempt to deserialize an object from within Servlet.service() prevented by JOT rule 'object-deserialization'

# The microsandbox for expression injection. Evaluating an expression is allowed, but while one is being
# evaluated it can't start a process or open a socket.
- name: expression
  description: Stops expressions from starting processes or opening sockets while they are evaluated
  methods:
  - java.lang.ProcessBuilder.<init>
  - java.net.Socket.<init>
  scopes:
  - javax.el.ValueExpression.getValue
  - jakarta.el.ValueExpression.getValue
  captures:
  - "#ARGS"
  exception: Expression language sandbox escape prevented by JOT rule 'expression'

# The pattern based alternative, which looks for attack text in the expression itself. It is easier to get
# around than the sandbox above. Add "protect: false" to stage it as report only, and the dashboard can then
# promote it to block.
- name: expression-suspicious
  description: Blocks expressions that contain reflection or process APIs
  methods:
  - javax.el.ExpressionFactory.createValueExpression
  - jakarta.el.ExpressionFactory.createValueExpression
  captures:
  - "#P1"
  matchers:
  - \.class
  - getRuntime
  - ProcessBuilder
  - forName
  exception: Suspicious expression detected by JOT rule 'expression-suspicious'

# The JVM must never be shut down by a web request.
- name: jvm-exit
  description: Blocks attempts to end the JVM from a web request
  methods:
  - java.lang.Runtime.exit
  - java.lang.Runtime.halt
  scopes:
  - javax.servlet.Servlet.service
  - jakarta.servlet.Servlet.service
  captures:
  - "#ARGS"
  exception: Attempt to end the JVM from within Servlet.service() prevented by JOT rule 'jvm-exit'
