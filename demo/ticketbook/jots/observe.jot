---
# TicketBook demo, the observe set. Every sensor here only records what it sees and never stops anything.
# It works on javax and jakarta servlet applications. A sensor watches only the names it lists, so each one lists both.
# The blocking rules are in ../rules/protect.jot, run.sh adds them in monitor and protect modes.

sensors:

##### the application #####

- name: get-route
  description: Identifies the entry point for this HTTP request
  methods:
  - javax.servlet.Servlet.service
  - jakarta.servlet.Servlet.service
  captures:
  - "#P0.getRequestURI()"

- name: get-user
  description: Identifies the user name of current user if authenticated
  methods:
  - javax.servlet.Servlet.service
  - jakarta.servlet.Servlet.service
  captures:
  - "#P0.getRemoteUser()==null ? \"Guest\" : #P0.getRemoteUser()"

- name: get-role
  description: Records authorization checks and whether the current user has the role
  methods:
  - javax.servlet.ServletRequest.isUserInRole
  - jakarta.servlet.ServletRequest.isUserInRole
  captures:
  - '#P0 + ": " + #RET'
  matchers:
  - '!^null:'
  - '!: null$'

- name: get-received-param-names
  description: Identifies parameter names used in HTTP requests
  methods:
  - javax.servlet.Servlet.service
  - jakarta.servlet.Servlet.service
  captures:
  - "#P0.getParameterNames()"
  matchers:
  - "!null"

- name: get-accessed-param-names
  description: Identifies parameter names referenced by the app
  methods:
  - javax.servlet.ServletRequest.getParameter
  - jakarta.servlet.ServletRequest.getParameter
  - javax.servlet.ServletRequest.getParameterValues
  - jakarta.servlet.ServletRequest.getParameterValues
  captures:
  - "#P0"
  matchers:
  - "!null"

- name: get-redirect
  description: Identifies a response redirect
  methods:
  - javax.servlet.ServletResponse.sendRedirect
  - jakarta.servlet.ServletResponse.sendRedirect
  captures:
  - "#P0"
  matchers:
  - "!null"

- name: get-forward
  description: Identifies a request forward
  methods:
  - javax.servlet.ServletRequest.getRequestDispatcher
  - jakarta.servlet.ServletRequest.getRequestDispatcher
  - javax.servlet.ServletContext.getRequestDispatcher
  - jakarta.servlet.ServletContext.getRequestDispatcher
  captures:
  - "#P0"
  matchers:
  - "!null"

- name: get-filter
  description: Identify a filter being added
  methods:
  - javax.servlet.ServletContext.addFilter
  - jakarta.servlet.ServletContext.addFilter
  captures:
  - "#RET.getUrlPatternMappings()"
  matchers:
  - "!null"

- name: get-servlet
  description: Identify a servlet being added
  methods:
  - javax.servlet.ServletContext.addServlet
  - jakarta.servlet.ServletContext.addServlet
  captures:
  - "#RET.getMappings()"
  matchers:
  - "!null"

- name: get-cache-header
  description: Identifies a cache header being set
  methods:
  - javax.servlet.ServletResponse.setHeader
  - jakarta.servlet.ServletResponse.setHeader
  captures:
  - "#P0.equalsIgnoreCase(\"Cache-Control\")?#P1:null"
  matchers:
  - "!null"

##### security relevant behavior #####

- name: get-cipher
  description: Records each use of an encryption cipher, its algorithm and whether it encrypts or decrypts
  methods:
  - javax.crypto.Cipher.init
  captures:
  - '#OBJ.getAlgorithm() + ": " + (#P0 == 1 ? "encrypt" : #P0 == 2 ? "decrypt" : "other")'

- name: get-hashes
  description: Identifies hash algorithm usage
  methods:
  - java.security.MessageDigest.getInstance
  captures:
  - "#P0"

- name: native-libraries
  description: Identifies the use of native libraries
  methods:
  - java.lang.System.load
  - java.lang.System.loadLibrary
  - java.lang.System.mapLibraryName
  captures:
  - "#P0"
  matchers:
  - "!null"

- name: get-unsafe-queries
  description: Identifies unparameterized database queries
  methods:
  - java.sql.Statement.execute
  - java.sql.Statement.addBatch
  - java.sql.Statement.executeQuery
  - java.sql.Statement.executeUpdate
  excludes:
  - java.sql.PreparedStatement   # these calls are harmless in PreparedStatement
  captures:
  - "#ARGS"

- name: get-safe-queries
  description: Identifies parameterized database queries
  methods:
  - java.sql.Connection.prepareCall
  - java.sql.Connection.prepareStatement
  captures:
  - "#ARGS"

- name: get-files
  description: Identifies the use of files outside the application and the server
  methods:
  - java.io.File.<init>
  captures:
  - "#OBJ.getCanonicalPath()"
  matchers:
  - "!/ticketbook"
  - "!/apache-tomcat"
  - "!/tomcat-base"
  - "!/openjdk"
  - "!/Cellar/"
  - "!/candidates/java/"

- name: get-sockets
  description: Identifies the use of sockets
  methods:
  - java.net.Socket.<init>
  captures:
  - "\"\"+#P0+\":\"+#P1"     # ""+#P0 is a shorthand String conversion
  matchers:
  - "!null:null"
  - "!:8080"               # any port that's not 8080
