---
# TicketBook demo, the observe set. Every sensor here only records what it sees and never stops anything.
# It works on javax and jakarta servlet applications. A sensor watches only the names it lists, so each one lists both.
# The blocking rules are in ../rules/protect.jot, run.sh adds them in monitor and protect modes.

sensors:

##### the application #####

- name: http-route
  description: Identifies the route a request came in at
  methods:
  - javax.servlet.Servlet.service
  - jakarta.servlet.Servlet.service
  captures:
    path: "#P0.getRequestURI()"

- name: auth-user
  description: Identifies the user making a request, or Guest when no one is signed in
  methods:
  - javax.servlet.Servlet.service
  - jakarta.servlet.Servlet.service
  captures:
    user: '#P0.getRemoteUser()==null ? "Guest" : #P0.getRemoteUser()'

- name: auth-role-check
  description: Identifies an authorization check and whether the current user has the role
  methods:
  - javax.servlet.ServletRequest.isUserInRole
  - jakarta.servlet.ServletRequest.isUserInRole
  captures:
    role: "#P0"
    allowed: "#RET"
    user: '#OBJ.getRemoteUser() == null ? "Guest" : #OBJ.getRemoteUser()'
  matchers:
    role:
      - "!null"
    allowed:
      - "!null"

- name: http-parameter-received
  description: Identifies the parameter names a request was sent with
  methods:
  - javax.servlet.Servlet.service
  - jakarta.servlet.Servlet.service
  captures:
    name: "#P0.getParameterNames()"
  matchers:
    name:
      - "!null"

- name: http-parameter-read
  description: Identifies the parameter names the application reads
  methods:
  - javax.servlet.ServletRequest.getParameter
  - jakarta.servlet.ServletRequest.getParameter
  - javax.servlet.ServletRequest.getParameterValues
  - jakarta.servlet.ServletRequest.getParameterValues
  captures:
    name: "#P0"
  matchers:
    name:
      - "!null"

- name: http-redirect
  description: Identifies a redirect being sent
  methods:
  - javax.servlet.ServletResponse.sendRedirect
  - jakarta.servlet.ServletResponse.sendRedirect
  captures:
    url: "#P0"
  matchers:
    url:
      - "!null"

- name: http-forward
  description: Identifies a request being forwarded
  methods:
  - javax.servlet.ServletRequest.getRequestDispatcher
  - jakarta.servlet.ServletRequest.getRequestDispatcher
  - javax.servlet.ServletContext.getRequestDispatcher
  - jakarta.servlet.ServletContext.getRequestDispatcher
  captures:
    path: "#P0"
  matchers:
    path:
      - "!null"

- name: http-filter-registered
  description: Identifies a filter being added at run time
  methods:
  - javax.servlet.ServletContext.addFilter
  - jakarta.servlet.ServletContext.addFilter
  captures:
    urls: "#RET.getUrlPatternMappings()"
  matchers:
    urls:
      - "!null"

- name: http-servlet-registered
  description: Identifies a servlet being added at run time
  methods:
  - javax.servlet.ServletContext.addServlet
  - jakarta.servlet.ServletContext.addServlet
  captures:
    urls: "#RET.getMappings()"
  matchers:
    urls:
      - "!null"

- name: http-cache-header
  description: Identifies a cache header being set
  methods:
  - javax.servlet.ServletResponse.setHeader
  - jakarta.servlet.ServletResponse.setHeader
  captures:
    cache_control: '#P0.equalsIgnoreCase("Cache-Control")?#P1:null'
  matchers:
    cache_control:
      - "!null"

##### security relevant behavior #####


- name: http-cookie-set
  description: Identifies a cookie being set and whether it is Secure and HttpOnly
  methods:
  - javax.servlet.http.HttpServletResponse.addCookie
  - jakarta.servlet.http.HttpServletResponse.addCookie
  captures:
    name: "#P0.getName()"
    secure: "#P0.getSecure()"
    http_only: "#P0.isHttpOnly()"

- name: http-security-header
  description: Identifies a security header being set and its value
  methods:
  - javax.servlet.ServletResponse.setHeader
  - jakarta.servlet.ServletResponse.setHeader
  - javax.servlet.ServletResponse.addHeader
  - jakarta.servlet.ServletResponse.addHeader
  captures:
    name: "#P0"
    value: "#P1"
  matchers:
    name:
      - (?i)^(Content-Security-Policy|Strict-Transport-Security|X-Frame-Options|X-Content-Type-Options|Referrer-Policy|Permissions-Policy|X-XSS-Protection|Cross-Origin-[\w-]+)$

- name: crypto-cipher
  description: Identifies a cipher being used, its algorithm and whether it encrypts or decrypts
  methods:
  - javax.crypto.Cipher.init
  captures:
    algorithm: "#OBJ.getAlgorithm()"
    operation: '#P0 == 1 ? "encrypt" : #P0 == 2 ? "decrypt" : "other"'

- name: crypto-hash
  description: Identifies a hash algorithm being used
  methods:
  - java.security.MessageDigest.getInstance
  captures:
    algorithm: "#P0"


- name: crypto-key-size
  description: Identifies the size of a key or key pair being generated
  methods:
  - java.security.KeyPairGenerator.initialize
  - javax.crypto.KeyGenerator.init
  captures:
    algorithm: "#OBJ.getAlgorithm()"
    bits: "#P0"
  matchers:
    algorithm:
      - ^[\w/-]+$

- name: crypto-key-spec
  description: Identifies the algorithm and length of a secret key built from bytes, the bytes themselves are not captured
  methods:
  - javax.crypto.spec.SecretKeySpec.<init>
  captures:
    algorithm: "#P1"
    bits: "#P0.length * 8"

- name: object-class
  description: Identifies the classes an ObjectInputStream turns bytes into
  methods:
  - java.io.ObjectInputStream.resolveClass
  captures:
    class: "#P0.getName()"

- name: sql-statement
  description: Identifies unparameterized database queries
  methods:
  - java.sql.Statement.execute
  - java.sql.Statement.addBatch
  - java.sql.Statement.executeQuery
  - java.sql.Statement.executeUpdate
  excludes:
  - java.sql.PreparedStatement   # these calls are harmless in PreparedStatement
  captures:
    sql: "#ARGS"

- name: sql-prepared
  description: Identifies parameterized database queries
  methods:
  - java.sql.Connection.prepareCall
  - java.sql.Connection.prepareStatement
  captures:
    sql: "#ARGS"

- name: sql-connection
  description: Identifies obtaining a database connection, and where it connects
  methods:
  - com.acme.ticketbook.Database.getConnection
  captures:
    url: "#RET?.getMetaData()?.getURL()"
    user: "#RET?.getMetaData()?.getUserName()"
    closed: "#RET?.isClosed()"

- name: file-path
  description: Identifies file and directory use
  methods:
  - java.io.File.<init>
  captures:
    path: "#OBJ.getCanonicalPath()"
  matchers:
    path:
      - "!/ticketbook"
      - "!/apache-tomcat"
      - "!/tomcat-base"
      - "!/openjdk"
      - "!/Cellar/"
      - "!/candidates/java/"

- name: net-socket
  description: Identifies a socket being opened
  methods:
  - java.net.Socket.<init>
  captures:
    host: "#P0"
    port: "#P1"
  matchers:
    host:
      - "!null"
    port:
      - "!^8080$"

- name: net-url
  description: Identifies the host and protocol of a URL being connected to
  methods:
  - java.net.URL.openConnection
  captures:
    host: "#OBJ.getHost()"
    protocol: "#OBJ.getProtocol()"
    port: "#OBJ.getPort() == -1 ? #OBJ.getDefaultPort() : #OBJ.getPort()"
  matchers:
    protocol:
      - (?i)^(https?|ftp)$

- name: crypto-cipher-key-size
  description: Identifies the algorithm and size in bits of the key used to initialize a cipher
  methods:
  - javax.crypto.Cipher.init
  captures:
    algorithm: "#P1.getAlgorithm()"
    bits: '#P1.getAlgorithm() == "RSA" ? #P1.getModulus().bitLength() : #P1.getEncoded().length * 8'

- name: thread-runnable
  description: Identifies a thread being created with a Runnable and the code that created it
  methods:
  - java.lang.Thread.<init>
  captures:
    runnable_classes: "#ARGS.![#this?.getClass()?.getName()]"
    caller: "#CALLER"
  matchers:
    runnable_classes:
    - '!^java\.lang\.(String|ThreadGroup|Long|Boolean)$'
