---
# Java Observability Toolkit (JOT)

  
reports:

 - name: Test Coverage Matrix
   type: compare
   rows: http-route
   cols: auth-user
   
 - name: Access Control Matrix
   type: compare
   rows: http-route
   cols: auth-role-check
   
 - name: Role Membership
   type: compare
   rows: auth-user
   cols: auth-role-check
   
 - name: Cache Headers
   type: table
   rows: http-route
   cols: http-cache-header
   
 - name: Encryption Algorithms
   type: compare
   rows: http-route
   cols: crypto-cipher  
   
 - name: Unauthorized Files
   type: table
   rows: http-route
   cols: file-path
   
 - name: Database Queries
   type: table
   rows: http-route
   cols: sql-statement
   
 - name: Encryption Users
   type: compare
   rows: auth-user
   cols: crypto-cipher
      
 - name: HTTP Parameters
   type: table
   rows: http-route
   cols: http-parameter-read, http-parameter-received
   
 - name: Request Forwards
   type: table
   rows: http-route
   cols: http-forward
   
    
   

 - name: Encryption Usage
   type: list
   cols: crypto-cipher

 - name: Hash Usage
   type: list
   cols: crypto-hash
