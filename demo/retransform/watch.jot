sensors:
- name: "file-created"
  methods:
  - "java.io.File.<init>"
  captures:
  - "#ARGS"
  matchers:
  - "var/data"
- name: "digest-requested"
  methods:
  - "java.security.MessageDigest.getInstance"
  captures:
  - "#P0"
- name: "process-created"
  methods:
  - "java.lang.ProcessBuilder.<init>"
  captures:
  - "#ARGS"
- name: "cipher-requested"
  methods:
  - "javax.crypto.Cipher.getInstance"
  captures:
  - "#P0"
