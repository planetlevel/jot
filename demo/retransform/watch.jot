sensors:
- name: file-created
  methods:
  - java.io.File.<init>
  captures:
    path: "#ARGS"
  matchers:
    path:
      - var/data
- name: file-path
  methods:
  - java.io.File.<init>
  captures:
    path: "#OBJ.getCanonicalPath()"
  matchers:
    path:
      - var/data
- name: digest-requested
  methods:
  - java.security.MessageDigest.getInstance
  captures:
    algorithm: "#P0"
- name: process-created
  methods:
  - java.lang.ProcessBuilder.<init>
  captures:
    command: "#ARGS"
- name: cipher-requested
  methods:
  - javax.crypto.Cipher.getInstance
  captures:
    algorithm: "#P0"
