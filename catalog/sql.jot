# JOT catalog, sql
# SQL. The connections opened, the statements run, what they changed and what came back. The report reads http-route from the web area.
# Copy what fits your application into its .jot/jot.yaml. The Assistant page does that for you.

sensors:

- name: sql-statement
  description: Identifies unparameterized database queries, the database they run against and the statement and connection settings they run with
  methods:
  - java.sql.Statement.execute
  - java.sql.Statement.addBatch
  - java.sql.Statement.executeQuery
  - java.sql.Statement.executeUpdate
  excludes:
  - java.sql.PreparedStatement   # these calls are harmless in PreparedStatement
  captures:
    sql: "#ARGS"
    database: "#OBJ.getConnection().getMetaData().getDatabaseProductName()"
    url: "#OBJ.getConnection().getMetaData().getURL()"
    user: "#OBJ.getConnection().getMetaData().getUserName()"
    schema: "#OBJ.getConnection().getSchema()"
    auto_commit: "#OBJ.getConnection().getAutoCommit()"
    isolation: "#OBJ.getConnection().getTransactionIsolation()"
    read_only: "#OBJ.getConnection().isReadOnly()"
    query_timeout: "#OBJ.getQueryTimeout()"
    max_rows: "#OBJ.getMaxRows()"
    fetch_size: "#OBJ.getFetchSize()"

- name: sql-prepared
  description: Identifies parameterized database queries, the database they are for, how many parameters they take and how they can be read
  methods:
  - java.sql.Connection.prepareCall
  - java.sql.Connection.prepareStatement
  captures:
    sql: "#P0"
    database: "#OBJ.getMetaData().getDatabaseProductName()"
    url: "#OBJ.getMetaData().getURL()"
    user: "#OBJ.getMetaData().getUserName()"
    schema: "#OBJ.getSchema()"
    auto_commit: "#OBJ.getAutoCommit()"
    isolation: "#OBJ.getTransactionIsolation()"
    read_only: "#OBJ.isReadOnly()"
    parameter_count: "#RET?.getParameterMetaData()?.getParameterCount()"
    result_set_type: "#RET?.getResultSetType()"
    result_set_concurrency: "#RET?.getResultSetConcurrency()"

- name: sql-connection
  description: Identifies a database connection being opened, the JDBC URL it connects to and the database and driver behind it
  methods:
  - java.sql.DriverManager.getConnection
  captures:
    url: "#P0"
    product: "#RET?.getMetaData()?.getDatabaseProductName()"
    version: "#RET?.getMetaData()?.getDatabaseProductVersion()"
    driver: "#RET?.getMetaData()?.getDriverName()"
    user: "#RET?.getMetaData()?.getUserName()"

- name: sql-update
  description: Identifies a database update being run and how many rows it changed
  methods:
  - java.sql.Statement.executeUpdate
  - java.sql.Statement.executeLargeUpdate
  captures:
    sql: "#P0"
    rows: "#RET"
    database: "#OBJ.getConnection().getMetaData().getDatabaseProductName()"
    auto_commit: "#OBJ.getConnection().getAutoCommit()"

- name: sql-result
  description: Identifies the shape of what a query returned, its columns, their types and the tables they came from
  methods:
  - java.sql.Statement.executeQuery
  captures:
    sql: "#P0"
    column_count: "#RET.getMetaData().getColumnCount()"
    columns: "{1,2,3,4,5,6,7,8}.?[#this <= #RET.getMetaData().getColumnCount()].![#RET.getMetaData().getColumnLabel(#this)]"
    types: "{1,2,3,4,5,6,7,8}.?[#this <= #RET.getMetaData().getColumnCount()].![#RET.getMetaData().getColumnTypeName(#this)]"
    tables: "{1,2,3,4,5,6,7,8}.?[#this <= #RET.getMetaData().getColumnCount()].![#RET.getMetaData().getTableName(#this)]"
    result_set_type: "#RET.getType()"
    fetch_size: "#RET.getFetchSize()"

- name: sql-metadata
  description: Identifies result set metadata being requested, with the number of columns and the table of the first column
  methods:
  - java.sql.ResultSet.getMetaData
  captures:
    column_count: "#RET?.getColumnCount()"
    first_table: "#RET?.getTableName(1)"
    first_column: "#RET?.getColumnName(1)"

- name: sql-schema-lookup
  description: Identifies the database schema being inspected for its tables, columns, keys or indexes, and the names it was asked about
  methods:
  - java.sql.DatabaseMetaData.getTables
  - java.sql.DatabaseMetaData.getColumns
  - java.sql.DatabaseMetaData.getPrimaryKeys
  - java.sql.DatabaseMetaData.getImportedKeys
  - java.sql.DatabaseMetaData.getExportedKeys
  - java.sql.DatabaseMetaData.getIndexInfo
  captures:
    args: "#ARGS"

reports:

- name: Database Queries
  type: table
  rows: http-route.path
  cols: sql-statement.sql
