# JOT catalog, ai
# AI agents built with Spring AI. The calls to a model, the tools it asks for and the tools that run. The model call and tool request sensors apply anywhere, and ai-tool-invoked needs the Spring AI @Tool annotation set as an entry point in the app section of the project's .jot/jot.yaml, with app entry '@org.springframework.ai.tool.annotation.Tool'. The tool reports read the sensors of the sql, file, network, deserialization, expression, runtime and crypto areas, and show what each tool reaches for in the ones that are in the configuration.
# Copy what fits your application into its .jot/jot.yaml. The Assistant page does that for you.

sensors:

- name: ai-model-call
  description: Identifies a call to an AI model, with the provider, the model and the parameters it was given, how many tools it was offered and how many tokens it used
  methods:
  - org.springframework.ai.anthropic.AnthropicChatModel.internalCall
  - org.springframework.ai.openai.OpenAiChatModel.internalCall
  - org.springframework.ai.ollama.OllamaChatModel.internalCall
  scopes: []
  captures:
    provider: "#OBJ.getClass().getSimpleName().replace('ChatModel', '').toLowerCase()"
    model: "#P0.options?.model"
    temperature: "#P0.options?.temperature"
    max_tokens: "#P0.options?.maxTokens"
    top_p: "#P0.options?.topP"
    top_k: "#P0.options?.topK"
    tools: "#P0.options?.toolCallbacks?.size()"
    messages: "#P0.instructions.size()"
    input_tokens: "#RET?.metadata?.usage?.promptTokens"
    output_tokens: "#RET?.metadata?.usage?.completionTokens"
    finish_reason: "#RET?.result?.metadata?.finishReason"

- name: ai-tool-request
  description: Identifies the model asking for a tool to be run, with the name of the tool and the arguments the model chose
  methods:
  - org.springframework.ai.tool.method.MethodToolCallback.call
  scopes: []
  captures:
    tool: "#OBJ.toolDefinition.name()"
    arguments: "#P0"

- name: ai-tool-invoked
  description: Identifies a tool of the agent being run, with the tool's name, the class it is in and the arguments it was given
  methods:
  - "@org.springframework.ai.tool.annotation.Tool"
  captures:
    tool: "#ANNOTATION.name"
    class: "#OBJ.getClass().getSimpleName()"
    arguments: "#ARGS"

reports:

- name: Models and Parameters
  type: table
  rows: ai-model-call.model
  cols: ai-model-call.provider, ai-model-call.temperature, ai-model-call.max_tokens, ai-model-call.top_p, ai-model-call.tools, ai-model-call.messages

- name: Token Use by Model
  type: table
  rows: ai-model-call.model
  cols: "#count(ai-model-call), #total(ai-model-call.input_tokens), #total(ai-model-call.output_tokens), ai-model-call.finish_reason"

- name: What the Model Asked For
  type: table
  rows: ai-tool-request.tool
  cols: ai-tool-request.arguments

- name: Tools Used
  type: table
  rows: ai-tool-invoked.tool
  cols: ai-tool-invoked.class

- name: Tool Arguments
  type: table
  rows: ai-tool-invoked.tool
  cols: ai-tool-invoked.arguments

- name: Tool Behavior
  type: table
  rows: ai-tool-invoked.tool
  cols: sql-statement.sql, file-path.path, native-process.command, net-url.host, expression-spel.expression, object-deserialization.args, crypto-cipher.algorithm, crypto-hash.algorithm

- name: Data Access by Tool
  type: table
  rows: ai-tool-invoked.tool
  cols: sql-statement.sql, file-path.path

- name: Reaching Out by Tool
  type: table
  rows: ai-tool-invoked.tool
  cols: net-url.host, net-url.protocol, native-process.command

- name: Code Execution by Tool
  type: table
  rows: ai-tool-invoked.tool
  cols: native-process.command, expression-spel.expression, object-deserialization.args

- name: Encryption by Tool
  type: table
  rows: ai-tool-invoked.tool
  cols: crypto-cipher.algorithm, crypto-cipher.key_algorithm, crypto-cipher.bits, crypto-cipher-request.algorithm
