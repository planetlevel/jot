# JOT catalog, web
# Web requests. What came in, who the user was, what was read from it and where the application sent the response. These watch the servlet API, so they cover javax and jakarta applications.
# Copy what fits your application into its .jot/jot.yaml. The Assistant page does that for you.

sensors:

- name: http-route
  description: Identifies the route a request came in at
  methods:
  - javax.servlet.Servlet.service
  - jakarta.servlet.Servlet.service
  captures:
    path: "#P0.getRequestURI()"
    method: "#P0.getMethod()"

- name: auth-user
  description: Identifies the user making a request, or Guest when no one is signed in
  methods:
  - javax.servlet.Servlet.service
  - jakarta.servlet.Servlet.service
  captures:
    user: '#P0.getRemoteUser()==null ? "Guest" : #P0.getRemoteUser()'

- name: auth-role-check
  description: Identifies an authorization check and whether the current user has the role
  methods:
  - javax.servlet.ServletRequest.isUserInRole
  - jakarta.servlet.ServletRequest.isUserInRole
  captures:
    role: "#P0"
    allowed: "#RET"
    user: '#OBJ.getRemoteUser() == null ? "Guest" : #OBJ.getRemoteUser()'
  matchers:
    role:
      - "!null"
    allowed:
      - "!null"

- name: http-parameter-received
  description: Identifies the parameter names a request was sent with
  methods:
  - javax.servlet.Servlet.service
  - jakarta.servlet.Servlet.service
  captures:
    name: "#P0.getParameterNames()"
  matchers:
    name:
      - "!null"

- name: http-parameter-read
  description: Identifies the parameter names the application reads
  methods:
  - javax.servlet.ServletRequest.getParameter
  - jakarta.servlet.ServletRequest.getParameter
  - javax.servlet.ServletRequest.getParameterValues
  - jakarta.servlet.ServletRequest.getParameterValues
  captures:
    name: "#P0"
  matchers:
    name:
      - "!null"

- name: http-redirect
  description: Identifies a redirect being sent
  methods:
  - javax.servlet.ServletResponse.sendRedirect
  - jakarta.servlet.ServletResponse.sendRedirect
  captures:
    url: "#P0"
  matchers:
    url:
      - "!null"

- name: http-forward
  description: Identifies a request being forwarded
  methods:
  - javax.servlet.ServletRequest.getRequestDispatcher
  - jakarta.servlet.ServletRequest.getRequestDispatcher
  - javax.servlet.ServletContext.getRequestDispatcher
  - jakarta.servlet.ServletContext.getRequestDispatcher
  captures:
    path: "#P0"
  matchers:
    path:
      - "!null"

- name: http-filter-registered
  description: Identifies a filter being added at run time
  methods:
  - javax.servlet.ServletContext.addFilter
  - jakarta.servlet.ServletContext.addFilter
  captures:
    urls: "#RET.getUrlPatternMappings()"
  matchers:
    urls:
      - "!null"

- name: http-servlet-registered
  description: Identifies a servlet being added at run time
  methods:
  - javax.servlet.ServletContext.addServlet
  - jakarta.servlet.ServletContext.addServlet
  captures:
    urls: "#RET.getMappings()"
  matchers:
    urls:
      - "!null"

- name: http-cache-header
  description: Identifies a cache header being set
  methods:
  - javax.servlet.ServletResponse.setHeader
  - jakarta.servlet.ServletResponse.setHeader
  captures:
    cache_control: '#P0.equalsIgnoreCase("Cache-Control")?#P1:null'
  matchers:
    cache_control:
      - "!null"

- name: http-cookie-set
  description: Identifies a cookie being set and whether it is Secure and HttpOnly
  methods:
  - javax.servlet.http.HttpServletResponse.addCookie
  - jakarta.servlet.http.HttpServletResponse.addCookie
  captures:
    name: "#P0.getName()"
    secure: "#P0.getSecure()"
    http_only: "#P0.isHttpOnly()"

- name: http-security-header
  description: Identifies a security header being set and its value
  methods:
  - javax.servlet.ServletResponse.setHeader
  - jakarta.servlet.ServletResponse.setHeader
  - javax.servlet.ServletResponse.addHeader
  - jakarta.servlet.ServletResponse.addHeader
  captures:
    name: "#P0"
    value: "#P1"
  matchers:
    name:
      - (?i)^(Content-Security-Policy|Strict-Transport-Security|X-Frame-Options|X-Content-Type-Options|Referrer-Policy|Permissions-Policy|X-XSS-Protection|Cross-Origin-[\w-]+)$

reports:

- name: Test Coverage Matrix
  type: compare
  rows: http-route.path
  cols: auth-user.user

- name: Access Control Matrix
  type: compare
  rows: http-route.path
  cols: auth-role-check.role
  value: auth-role-check.allowed
  by: auth-role-check.user

- name: Role Membership
  type: compare
  rows: auth-role-check.user
  cols: auth-role-check.role
  value: auth-role-check.allowed

- name: Cache Headers
  type: table
  rows: http-route.path
  cols: http-cache-header.cache_control

- name: HTTP Parameters
  type: table
  rows: http-route.path
  cols: http-parameter-read.name, http-parameter-received.name

- name: Request Forwards
  type: table
  rows: http-route.path
  cols: http-forward.path
